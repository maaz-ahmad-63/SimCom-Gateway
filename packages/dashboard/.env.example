# SIM7600EI Cellular Gateway - Dashboard Configuration
# Note: The dashboard can also be configured interactively at runtime via the /settings page,
# which stores credentials securely in browser localStorage without rebuilding or baking keys into client bundles.

# Default Gateway API & Socket.IO URL
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000

# Optional default API key for development convenience.
# WARNING: Variables prefixed with NEXT_PUBLIC_ are baked into client-side browser bundles.
# Never commit production keys here. For production or remote Windows gateway hosts,
# enter the API key in the Dashboard Settings page (/settings) or leave this empty.
NEXT_PUBLIC_GATEWAY_API_KEY=change-this-to-a-secure-random-token
