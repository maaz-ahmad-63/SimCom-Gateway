# ==============================================================================
# SIM7600EI Cellular Gateway - Environment Configuration Example
# ==============================================================================

# Server Network Configuration
# Safe defaults: Bind to 127.0.0.1 for local dev. Use 0.0.0.0 on Windows gateway host with API key.
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Security & Authentication
# Mandatory API key for REST endpoints and Socket.IO connection authentication
GATEWAY_API_KEY=change-this-to-a-secure-random-token
CORS_ORIGIN=http://localhost:3000

# Modem Hardware Configuration
# Set to 'mock' for local macOS dev (default); set to 'hardware' on Windows gateway host
MODEM_DRIVER=mock
# Leave both ports empty to have the gateway find them: it reads the modem's USB identity (VID 1E0E, interface MI_02 = AT,
# MI_04 = audio, grouped by physical device) each time it opens a port, so a COM number Windows reassigned is followed.
# Nothing is written back to this file. Set a port only to override discovery; it is then used exactly as given.
# List what Windows has with: powershell -File tools/inspect-sim7600-windows.ps1 -List  (or the dashboard Hardware page)
# MODEM_AT_PORT = "Simcom HS-USB AT PORT 9001", MODEM_AUDIO_PORT = "Simcom HS-USB Audio 9001"
MODEM_AT_PORT=
MODEM_AT_BAUD=115200
MODEM_AUDIO_PORT=
MODEM_AUDIO_BAUD=115200
# With more than one SIMCom modem connected the gateway opens none until you choose one (its id is on the Hardware page):
# MODEM_DEVICE=1E0E:9001:6&3A1B2C4D&0

# Hardware Timeouts & Reconnection
MODEM_COMMAND_TIMEOUT_MS=5000
MODEM_DIAL_TIMEOUT_MS=20000
MODEM_AUTO_RECONNECT=true

# Audio Diagnostics & Streaming
# Audio format is treated as unvalidated raw stream until verified on hardware
AUDIO_SAMPLE_RATE=8000
AUDIO_CHANNELS=1
AUDIO_BIT_DEPTH=16
AUDIO_DUMP_DIRECTORY=./audio-dumps
# Unbounded whole-call raw dump; off by default. true/false/1/0/yes/no/on/off accepted.
AUDIO_ENABLE_RAW_DUMP=false
# Opt-in USB PCM verification tests (also need AUDIO_USB_DIAGNOSTIC_ENABLED=true)
AUDIO_USB_DIAGNOSTIC_ENABLED=false
AUDIO_USB_PCM_CAPTURE_TEST_ENABLED=false
AUDIO_USB_PCM_OUTBOUND_TONE_TEST_ENABLED=false

# ==============================================================================
# AI voice agent (optional, OFF by default; ported from labs-sizh-voicely)
# The gateway runs exactly as before with all of this unset. See docs/AI_VOICE_AGENT.md.
# A bad value here disables the AI agent and is reported; it never stops the gateway.
# ==============================================================================
AI_ENABLED=false
# Calls that get an agent without being armed by hand: off | inbound | outbound | all
AI_AUTO_HANDLE=off
AI_LANGUAGE=en

# Provider slugs are the source project's own (stt_config / llm_config / service_factory).
AI_STT=nova-3                 # nova-3 | nova-3-multi | groq_whisper
AI_LLM=groq_qwen_3_8_27b      # groq_* | openai_* | telnyx_* (gemini_3_flash is not ported)
AI_TTS=cartesia               # cartesia | deepgram (deepgram needs an aura-* voice)
AI_TTS_VOICE=katie
AI_TTS_CONCURRENCY=1           # simultaneous TTS requests per provider key (1-4); 1 avoids provider 429s
# AI_STT_KEYTERMS=Acme,Beta Corp
# AI_SYSTEM_INSTRUCTIONS=You are the receptionist for ...
# AI_SYSTEM_PROMPT_FILE=
# AI_GREETING=
# Instructions and greeting for ONE kind of call. Empty: that kind of call uses AI_SYSTEM_INSTRUCTIONS / AI_GREETING above.
# AI_INBOUND_INSTRUCTIONS=You are the receptionist for ...
# AI_INBOUND_GREETING=Thank you for calling Acme, how can I help?
# AI_OUTBOUND_INSTRUCTIONS=You are calling on behalf of Acme about ...
# AI_OUTBOUND_GREETING=Hi, this is Sam from Acme.

# Provider API keys, named as in the source project. Set only the ones your slugs need.
DEEPGRAM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
TELNYX_API_KEY=
CARTESIA_API_KEY=
# TELNYX_LLM_REGION_MODE=preferred   # preferred | strict
# CARTESIA_VERSION=2026-08-14

# Gateway-side audio. Never defaulted: set the rate only once it is verified on the hardware.
# AI_AUDIO_SAMPLE_RATE=
# Set these to true ONLY with the evidence in docs/USB_PCM_HARDWARE_RESULTS.md (intelligible
# incoming speech; a remote party hearing blind test tones). A live call is refused until then.
AI_AUDIO_INBOUND_VERIFIED=false
AI_AUDIO_OUTBOUND_VERIFIED=false

# Safety and cost controls
AI_ALLOW_AGENT_HANGUP=false          # true lets the agent's END_CALL hang up (attempted once, never retried)
AI_LOG_TRANSCRIPTS=false             # true puts transcripts in results/logs; audio is never recorded
AI_OBSERVABILITY_STORE_TEXT=false      # true also stores caller/agent text in the call trace events (off by default)
AI_OBSERVABILITY_RETENTION_DAYS=30       # trace events older than this are removed (0 = keep forever); calls and turn timings are never removed
AI_OBSERVABILITY_MAX_EVENTS=1000000     # oldest trace events are dropped above this count (0 = no cap)
AI_BARGE_IN=true
# Half-duplex turn-taking: caller audio is ignored while the agent speaks (and AI_PLAYBACK_GUARD_MS after),
# so the agent cannot answer its own voice coming back through the caller's phone. With it on, barge-in during
# speech cannot happen. Set false only after a real call proved simultaneous capture/playback is clean.
AI_HALF_DUPLEX=true
AI_PLAYBACK_GUARD_MS=500
AI_STT_TIMEOUT_MS=8000
AI_LLM_FIRST_TOKEN_TIMEOUT_MS=8000
AI_LLM_TOTAL_TIMEOUT_MS=30000
AI_TTS_TIMEOUT_MS=8000
AI_MAX_RETRIES=1
AI_MAX_HISTORY_MESSAGES=20
AI_MAX_RESPONSE_CHARS=600
AI_MAX_CONSECUTIVE_FAILURES=3
# AI_LLM_MAX_TOKENS=300
AI_VAD_RMS_THRESHOLD=0.003   # fraction of full scale; captured speech on this modem sits near 0.005 RMS (-47 dBFS), idle line noise near 0.0001
AI_VAD_MIN_SPEECH_MS=200
AI_VAD_MIN_SILENCE_MS=1000
AI_SKIP_UNLIKELY_SPEECH=false

# --- AI control center (dashboard: AI Agent page) ---------------------------------------------------
# Lets you store provider API keys from the dashboard. Keys are encrypted (AES-256-GCM) in the gateway
# database with a key derived from this value and are never sent back to the browser. Use 16+ random
# characters, keep it only here, and do not change it later (stored keys would become unreadable).
# Without it, keys in this file still work; the dashboard just cannot store new ones.
# AI_SECRETS_MASTER_KEY=

# --- Hands-free calling (all OFF by default; also editable on the dashboard's Agent tab) -------------------
# Answer incoming calls after N rings. Needs AI_AUTO_HANDLE=inbound|all and AI_AUTO_ACTIVATE_USB_AUDIO=true.
AI_AUTO_ANSWER=false
AI_AUTO_ANSWER_RINGS=2
# Send the documented AT+CPCMREG=1 once when an eligible call becomes ACTIVE (needs AUDIO_USB_DIAGNOSTIC_ENABLED=true).
AI_AUTO_ACTIVATE_USB_AUDIO=false
# Let the agent speak without a per-call click. Only acts while the whole readiness check passes, which needs
# AI_AUDIO_INBOUND_VERIFIED and AI_AUDIO_OUTBOUND_VERIFIED (or the dashboard confirmations). Keep false until
# agent audio has been heard by a real remote party.
AI_AUTO_REPLIES=false
# The AI lets go of a call after this many seconds (the call itself is not ended).
AI_MAX_CALL_SECONDS=900
# "Are you still there?" prompts (replies only): 15 s, 9 s more, 8 s more, then a goodbye.
AI_IDLE_FOLLOWUPS=true
# After repeated provider failures the agent stops, then may try one turn again after this long.
AI_RECOVERY_COOLDOWN_MS=15000
# Settings saved from the dashboard (providers, agent instructions, timeouts, confirmations) are kept in the
# SQLite database and take precedence over the AI_* values above; removing them falls back to this file.

# Database Persistence
SQLITE_DB_PATH=./data/gateway.sqlite

# Mock Modem Settings (applicable only when MODEM_DRIVER=mock)
MOCK_SIGNAL_STRENGTH=24
MOCK_CARRIER_NAME="Vi India"
MOCK_SIM_STATUS=READY
MOCK_OUTBOUND_AUTO_ANSWER_DELAY_MS=3000
MOCK_INBOUND_RING_COUNT=4

# ---- Complete-call recording (OFF by default; separate from the diagnostic captures in AUDIO_DUMP_DIRECTORY) ----
# Saves, per call, <dir>/<callId>/caller.wav (audio from the modem), agent.wav (audio written to the modem) and
# recording.json. Recording people can require notice or consent where you and they are. Enabling it is not enough:
# you must also acknowledge that you have handled that. Recordings can be personal data: protect the directory.
CALL_RECORDING_ENABLED=false
CALL_RECORDING_CONSENT_ACKNOWLEDGED=false
CALL_RECORDING_DIR=./call-recordings
CALL_RECORDING_RETENTION_DAYS=0     # 0 keeps recordings until you delete them; N deletes finished ones older than N days
CALL_RECORDING_MAX_SECONDS=3600     # a longer call stops being recorded (the file stays valid)

# ---- Reply speed (see docs/AI_VOICE_AGENT.md) ----
AI_VAD_MIN_SILENCE_MS=650            # wait this long after the caller stops before replying (default 1000)
AI_LLM_FIRST_TOKEN_TIMEOUT_MS=3000   # a stalled LLM request is retried after this long (default 8000)
# AI_DEEPGRAM_SPEAK_URL=https://api.deepgram.com/v1/speak   # try another Deepgram region; must be https on deepgram.com

# ---- Turn-taking (see docs/AI_VOICE_AGENT.md, "Turn-taking, latency and memory") ----
# AI_VAD_ADAPTIVE=false                # off by default: it only saw pauses shorter than its own wait, so it ratcheted down to the floor and cut callers off
# AI_VAD_MIN_SILENCE_FLOOR_MS=450      # only used when AI_VAD_ADAPTIVE=true
# AI_VAD_ONSET_HANGOVER_MS=100         # a brief gap inside the first word(s) does not discard the speech before it
# AI_VAD_SOFT_SILENCE_MS=350           # transcribe during the pause (0 turns it off)
# AI_SPECULATIVE_STT=true              # reuse that transcript at the real end of the turn
# AI_EARLY_COMMIT=false                # answer before the silence wait ends when the sentence looks finished (batch STT only; not used with streaming)
# AI_STT_STREAMING=false               # stream caller audio to Deepgram while they speak (needs DEEPGRAM_API_KEY); AI_STT stays the fallback
# AI_REGISTRY_DIR=./data/registry      # where the AI Model Hub's JSON registry files live (default: a "registry" folder beside the database). No keys are stored there.
# AI_STT_STREAM_FINALIZE_MS=1500      # how long the end of a turn waits for Deepgram's final text before the batch provider takes over
# AI_STT_STREAM_HEDGE_MS=700           # if the stream has not answered this long after the turn ended, the batch request starts too (the stream still wins if it answers first; the other is cancelled). 0 = off. The early request is billed even when the stream wins.
# AI_VAD_ENGINE=energy                 # energy (default) | silero (needs onnxruntime-node and AI_VAD_SILERO_MODEL, otherwise it is reported and energy is used)
# AI_VAD_SILERO_MODEL=C:/path/to/silero_vad.onnx
# AI_VAD_SILERO_THRESHOLD=0.5          # speech probability that counts as speech (the source uses 0.5)
# AI_BARGE_IN_WHILE_SPEAKING=true      # hear the caller interrupt (false = strict half-duplex)
# AI_BARGE_IN_MS=300
# AI_BARGE_IN_ECHO_MULT=2.5
# AI_BARGE_IN_MAX_FALSE=2
# AI_PLAYBACK_LEAD_FRAMES=2            # 20 ms frames written ahead; try 3 if gapRiskFrames is often above 0
# AI_PLAYBACK_PREROLL_MS=150
# AI_FIRST_SENTENCE_MIN_CHARS=24       # lower (e.g. 6) lets a short opener such as "Sure." play on its own
AI_FIRST_CLAUSE_MIN_CHARS=32          # first chunk of a reply may end at a comma/colon once this long, so speech starts earlier (0 = sentence ends only)
# AI_LLM_MAX_TOKENS=220
# AI_CALL_NOTES=true                   # remember facts from turns that scroll out of the history
# AI_CONTACT_DETAILS=true             # keep the name and phone number the caller gave (digits as heard, "?" for an unclear one) so the agent does not ask again or guess
# AI_LLM_REASONING_EFFORT=low          # gpt-oss models only: low | medium | high. Low is right for one or two spoken sentences
# AI_LLM_REASONING_TOKENS=1024         # gpt-oss models only: tokens added to AI_LLM_MAX_TOKENS for hidden reasoning, so it cannot use the whole reply budget (0 = none)
# AI_KNOWLEDGE_DIR=C:/path/to/verified-company-facts   # .md/.txt files; retrieved per question, never pasted whole

# ---- SMS inbox and dashboard SMS page (see docs/API.md, 3.9 and 3.10) ----
# SMS_INBOX_ENABLED=true               # false = do not watch for +CMTI or read the modem's messages at startup
# SMS_POLL_INTERVAL_MS=0               # read the storage on a fixed timer as well (0 = off; otherwise 60000 or more)
# SMS_FALLBACK_POLL_MS=120000          # until the first +CMTI arrives, read the storage this often (0 = off, minimum 60000)
# Dashboard server only (the SMS page relays through the dashboard server; the key never reaches the browser):
# GATEWAY_INTERNAL_URL=http://127.0.0.1:4000
# DASHBOARD_SMS_ALLOW_REMOTE=false     # true lets the page be used from another PC on the LAN (anyone who can open it can send SMS)
